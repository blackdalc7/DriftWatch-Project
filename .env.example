# Copy to .env and replace every value marked CHANGE_ME. `make secrets` prints fresh random values.
DRIFTWATCH_ADMIN_TOKEN=CHANGE_ME_at_least_24_chars
DRIFTWATCH_PROXY_SECRET=CHANGE_ME_at_least_24_chars
ELASTIC_PASSWORD=CHANGE_ME
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_chars_minimum_for_kibana__
DRIFTWATCH_LAB_TAGS=lab
DRIFTWATCH_TIMEZONE=Europe/London
MOCK_EDR_CLIENT_ID=driftwatch-lab
MOCK_EDR_CLIENT_SECRET=CHANGE_ME
# Optional: Claude drafts tests from CISA advisories (offline mapper is used without it).
ANTHROPIC_API_KEY=
