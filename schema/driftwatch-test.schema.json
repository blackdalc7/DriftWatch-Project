{
  "$defs": {
    "Attack": {
      "additionalProperties": false,
      "description": "ATT&CK mapping.",
      "properties": {
        "tactic": {
          "title": "Tactic",
          "type": "string"
        },
        "techniques": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Techniques",
          "type": "array"
        }
      },
      "required": [
        "tactic",
        "techniques"
      ],
      "title": "Attack",
      "type": "object"
    },
    "Expected": {
      "additionalProperties": false,
      "description": "What a working defense looks like for this test.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/Outcome",
          "default": "detected"
        },
        "detections": {
          "description": "Sigma rule ids that must fire",
          "items": {
            "type": "string"
          },
          "title": "Detections",
          "type": "array"
        },
        "window_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 30,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "title": "Expected",
      "type": "object"
    },
    "Outcome": {
      "description": "How a single run scored.",
      "enum": [
        "prevented",
        "detected",
        "missed",
        "error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where the test came from.",
      "properties": {
        "source": {
          "default": "manual",
          "pattern": "^(manual|cisa|atomic-red-team)$",
          "title": "Source",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        },
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "description": "The human review that moved a draft to approved.",
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Review",
      "type": "object"
    },
    "ReviewStatus": {
      "description": "Review state of a test.",
      "enum": [
        "draft",
        "approved",
        "verified"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "One catalog action with its parameters.",
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "action"
      ],
      "title": "Step",
      "type": "object"
    },
    "Verification": {
      "additionalProperties": false,
      "description": "The lab run that moved an approved test to verified.",
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        }
      },
      "title": "Verification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete test definition.",
  "properties": {
    "id": {
      "pattern": "^dw-[a-z0-9][a-z0-9-]{2,62}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 10,
      "title": "Description",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "draft"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Platforms",
      "type": "array"
    },
    "severity": {
      "default": "medium",
      "pattern": "^(low|medium|high|critical)$",
      "title": "Severity",
      "type": "string"
    },
    "attack": {
      "$ref": "#/$defs/Attack"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "expected": {
      "$ref": "#/$defs/Expected"
    },
    "hygiene_controls": {
      "items": {
        "type": "string"
      },
      "title": "Hygiene Controls",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "review": {
      "$ref": "#/$defs/Review"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "platforms",
    "attack",
    "steps"
  ],
  "title": "Driftwatch test",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftwatch.dev/schema/driftwatch-test.schema.json"
}
