# Mock Microsoft Graph Secure Score + CrowdStrike ZTA APIs for the lab.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app/src
RUN useradd --system --uid 10002 --home /app mockedr
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY src ./src
USER mockedr
EXPOSE 8080
CMD ["python", "-m", "driftwatch", "mock-edr", "--host", "0.0.0.0", "--port", "8080"]
