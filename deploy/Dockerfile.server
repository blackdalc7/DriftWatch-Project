# Driftwatch control server (FastAPI) with the built UI. Multi-stage: build the UI, then a slim runtime.
FROM node:26-alpine AS ui
WORKDIR /build
COPY packages/aegis-ui ./packages/aegis-ui
COPY web ./web
WORKDIR /build/web
RUN npm ci --no-audit --no-fund && npm run build

FROM python:3.15-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src DRIFTWATCH_UI_DIR=/app/web/dist DRIFTWATCH_DATA_DIR=/data
RUN groupadd --system --gid 10001 driftwatch && useradd --system --uid 10001 --gid driftwatch --home /app driftwatch
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY src ./src
COPY library ./library
COPY rules ./rules
COPY --from=ui /build/web/dist ./web/dist
RUN mkdir -p /data && chown -R driftwatch:driftwatch /data
USER driftwatch
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)"
CMD ["python", "-m", "driftwatch", "serve", "--host", "0.0.0.0", "--port", "8000"]
