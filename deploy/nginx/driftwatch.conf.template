# mTLS front door for Driftwatch. Rendered by the nginx image's envsubst step at container start
# (only ${DRIFTWATCH_PROXY_SECRET} is substituted; nginx's own $variables are left alone).
#
# Port 8443 (agents): client certificates are verified against the Driftwatch CA. The verified PEM is
# forwarded so the server can compute the SHA-256 fingerprint and match it to the enrolled agent.
# Enrollment is the only agent route reachable without a certificate (it needs a TTL token instead).
#
# Port 443 (operators): UI and operator API with server-side TLS only; the API itself requires X-API-Key.
# Agent routes are not exposed here at all.

upstream driftwatch_server { server server:8000; keepalive 16; }

limit_req_zone $binary_remote_addr zone=enroll:1m rate=6r/m;

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate         /etc/driftwatch/pki/server.crt;
    ssl_certificate_key     /etc/driftwatch/pki/server.key;
    ssl_client_certificate  /etc/driftwatch/pki/ca.crt;
    ssl_verify_client       optional;
    ssl_verify_depth        1;
    ssl_protocols           TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache       shared:dwagents:5m;

    client_max_body_size 2m;

    # Never trust identity headers from the client.
    proxy_set_header X-Client-Verify "";
    proxy_set_header X-Client-Cert   "";

    location = /api/v1/enroll {
        limit_req zone=enroll burst=3 nodelay;
        proxy_set_header Host               $host;
        proxy_set_header X-Driftwatch-Proxy "${DRIFTWATCH_PROXY_SECRET}";
        proxy_set_header X-Client-Verify    "NONE";
        proxy_set_header X-Client-Cert      "";
        proxy_pass http://driftwatch_server;
    }

    location /api/v1/agent/ {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        proxy_set_header Host               $host;
        proxy_set_header X-Driftwatch-Proxy "${DRIFTWATCH_PROXY_SECRET}";
        proxy_set_header X-Client-Verify    $ssl_client_verify;
        proxy_set_header X-Client-Cert      $ssl_client_escaped_cert;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://driftwatch_server;
    }

    location / { return 404; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/driftwatch/pki/server.crt;
    ssl_certificate_key /etc/driftwatch/pki/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'" always;

    client_max_body_size 2m;

    location /api/v1/agent/  { return 404; }
    location = /api/v1/enroll { return 404; }

    location / {
        proxy_set_header Host               $host;
        proxy_set_header X-Driftwatch-Proxy "";
        proxy_set_header X-Client-Verify    "";
        proxy_set_header X-Client-Cert      "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_pass http://driftwatch_server;
    }
}
